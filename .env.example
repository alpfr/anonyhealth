# AnonyHealth Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# Supabase project (https://app.supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Sentry error tracking — optional (leave blank to disable)
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development
